<?xml version="1.0" encoding="utf-8"?>
<!--
  R2 Main: the robot's behavior. Updated over Wi-Fi through the agent.
  It never touches the serial port itself; it talks to the agent's bridge on 127.0.0.1:7701.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.r2hack.main">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- DLNA renderer: discovery needs multicast on Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application android:label="R2 Main" android:allowBackup="false">
        <activity android:name=".MainActivity" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".BrainService" android:exported="false" />
    </application>
</manifest>
